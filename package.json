{
  "name": "agentforge",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "cli": "bun run src/index.ts",
    "run-tests": "bun run src/cli/run-tests.ts",
    "mcp-server": "bun run src/mcp/index.ts",
    "build:cli": "bun build src/index.ts --outdir ./dist --target bun --external playwright-core",
    "build:mcp": "bun build src/mcp/index.ts --outdir ./dist/mcp --target bun --external playwright-core",
    "build:all": "bun run build:cli \u0026\u0026 bun run build:mcp",
    "start": "bun run dist/cli.js",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@langchain/community": "^0.3.21",
    "@langchain/core": "^1.1.1",
    "@langchain/google-genai": "^2.0.1",
    "@langchain/langgraph": "^1.0.2",
    "@langchain/openai": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@types/pngjs": "^6.0.5",
    "adze": "^2.2.5",
    "jsdom": "22.1.0",
    "otplib": "^13.1.1",
    "pixelmatch": "^7.1.0",
    "playwright-core": "^1.57.0",
    "pngjs": "^7.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "21.1.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
