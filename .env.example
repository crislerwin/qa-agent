# === AI Models (Required - Choose at least one) ===

# OpenRouter (Recommended - has free models like Gemini Flash, Llama, Qwen)
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=google/gemini-flash-1.5

# Google AI Studio (Alternative - Gemini models with generous free tier)
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# === API Configuration ===
API_PORT=8000
# Comma-separated list of allowed origins for CORS (e.g. http://localhost:3000,https://myapp.com)
# Leave empty to allow all origins (default)
CORS_ORIGINS=

# Comma-separated list of allowed IPs
# Leave empty to allow all IPs
ALLOWED_IPS=

# === Optional Services ===

# PostgreSQL - Vector database for RAG/Knowledge Base
# When running locally (outside Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents_db
# When running in Docker (docker-compose):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agents_db
# Note: docker-compose.yml sets this automatically, so you can leave it commented

# Tavily - Web search API
# TAVILY_API_KEY=

# Redis - Chat memory/history
# When running locally (outside Docker):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# When running in Docker (docker-compose):
# REDIS_HOST=redis
# REDIS_PORT=6379
# Note: docker-compose.yml sets this automatically, so you can leave it commented

# OR Hosted (Upstash):
# REDIS_URL=redis://default:password@host:port

# Discord - For Discord bot integration
# DISCORD_BOT_TOKEN=

# Google Calendar/Meet - For meeting scheduling
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# GOOGLE_REFRESH_TOKEN=
